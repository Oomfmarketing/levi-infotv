<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://levitv.com/tizen" version="1.0.0" viewmodes="maximized">
    <tizen:application id="LeviTVApp1.LeviTV" package="LeviTVApp1" required_version="4.0"/>
    <name>LeviTV</name>
    <description>LeviTV.com — your real-time view of Levi: live cameras, weather, northern lights and daylight.</description>
    <author href="https://oomf.fi" email="hello@oomf.fi">OOMF Marketing Oy</author>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>

    <!-- The app opens https://levitv.com/tv.html, which embeds YouTube live cameras -->
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>levitv.com *.levitv.com youtube.com *.youtube.com *.youtube-nocookie.com *.ytimg.com *.googlevideo.com</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data: blob:;</tizen:content-security-policy>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>

    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
